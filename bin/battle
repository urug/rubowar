#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rubowar"
require "optparse"
require "json"

options = {
  width: 800,
  height: 600,
  friction: 0.95,
  chronon_limit: 1000,
  battles: 1,
  format: "text",
  seed: nil,
  watch: false,
  delay: 0.05,
  html: nil,
  json_log: nil
}

OptionParser.new do |opts|
  opts.banner = "Usage: bin/battle [options] rubot1.rb rubot2.rb [rubot3.rb ...]"

  opts.separator ""
  opts.separator "Arena options:"

  opts.on("-W", "--width WIDTH", Integer, "Arena width (default: 800)") do |w|
    options[:width] = w
  end

  opts.on("-H", "--height HEIGHT", Integer, "Arena height (default: 600)") do |h|
    options[:height] = h
  end

  opts.on("-f", "--friction FRICTION", Float, "Friction coefficient (default: 0.95)") do |f|
    options[:friction] = f
  end

  opts.on("-t", "--chronons LIMIT", Integer, "Chronon limit per battle (default: 1000)") do |t|
    options[:chronon_limit] = t
  end

  opts.separator ""
  opts.separator "Simulation options:"

  opts.on("-n", "--battles COUNT", Integer, "Number of battles to run (default: 1)") do |n|
    options[:battles] = n
  end

  opts.on("-s", "--seed SEED", Integer, "Random seed for reproducibility") do |s|
    options[:seed] = s
  end

  opts.separator ""
  opts.separator "Renderer options:"

  opts.on("-w", "--watch", "--terminal", "Watch battle live in terminal") do
    options[:watch] = true
  end

  opts.on("-d", "--delay SECONDS", Float, "Delay between frames in watch mode (default: 0.05)") do |d|
    options[:delay] = d
  end

  opts.on("--html", "Generate HTML replay file in battle-logs/") do
    options[:html] = "battle-logs"
  end

  opts.on("--html-dir DIR", "Generate HTML replay file in specified directory") do |dir|
    options[:html] = dir
  end

  opts.on("--json", "Generate JSON log file in battle-logs/") do
    options[:json_log] = :auto
  end

  opts.on("--json-file FILE", "Generate JSON log to specified file") do |file|
    options[:json_log] = file
  end

  opts.separator ""
  opts.separator "Output options:"

  opts.on("-o", "--output FORMAT", %w[text json csv], "Summary format: text, json, csv (default: text)") do |fmt|
    options[:format] = fmt
  end

  opts.on("-q", "--quiet", "Suppress summary output (useful with --html or --json-log)") do
    options[:quiet] = true
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end.parse!

# Load rubot files
rubot_files = if ARGV.empty?
                Dir.glob(File.join(__dir__, "..", "rubots", "*.rb"))
              else
                ARGV.map { |f| File.expand_path(f) }
              end

if rubot_files.size < 2
  warn "Error: Need at least 2 rubots to battle"
  warn "Usage: bin/battle [options] rubot1.rb rubot2.rb [rubot3.rb ...]"
  exit 1
end

rubot_classes = []
rubot_files.each do |file|
  unless File.exist?(file)
    warn "Error: File not found: #{file}"
    exit 1
  end

  before = ObjectSpace.each_object(Class).select do |c|
    c.include?(Rubowar::Rubot)
  rescue StandardError
    false
  end
  require file
  after = ObjectSpace.each_object(Class).select do |c|
    c.include?(Rubowar::Rubot)
  rescue StandardError
    false
  end
  new_classes = after - before

  if new_classes.empty?
    warn "Error: No Rubot class found in #{file}"
    exit 1
  end

  rubot_classes << new_classes.first
end

# Set random seed if provided
srand(options[:seed]) if options[:seed]

# Helper to generate auto filename for JSON log
def generate_json_filename(rubot_classes)
  require "fileutils"
  FileUtils.mkdir_p("battle-logs")
  timestamp = Time.now.strftime("%Y%m%d-%H%M%S")
  names = rubot_classes.map { |c| c.name.downcase.gsub(/[^a-z0-9]/, "") }.join("-vs-")
  "battle-logs/battle-#{timestamp}-#{names}.json"
end

# Run battles
results = []
options[:battles].times do |i|
  battle = Rubowar::Battle.local(
    rubot_classes,
    width: options[:width],
    height: options[:height],
    friction: options[:friction],
    chronon_limit: options[:chronon_limit]
  )

  renderers = []

  # Terminal renderer (watch mode)
  if options[:watch]
    terminal = Rubowar::Renderers::Terminal.new(battle)
    battle.on(:chronon) do |tick_state|
      terminal.render(tick_state)
      sleep options[:delay]
    end
    renderers << terminal
  end

  # HTML Canvas renderer
  if options[:html]
    html = Rubowar::Renderers::HtmlCanvas.new(battle, output_dir: options[:html])
    battle.on(:chronon) { |tick_state| html.render(tick_state) }
    battle.on(:battle_end) { |data| html.render_final(data[:winner]) }
    renderers << html
  end

  # JSON Logger renderer
  if options[:json_log]
    json_file = options[:json_log] == :auto ? generate_json_filename(rubot_classes) : options[:json_log]
    json_output = File.open(json_file, "w")
    json_logger = Rubowar::Renderers::JsonLogger.new(battle, output: json_output)
    battle.on(:chronon) { |tick_state| json_logger.render(tick_state) }
    battle.on(:battle_end) { |data| json_logger.render_final(data[:winner]) }
    renderers << { renderer: json_logger, output: json_output, file: json_file }
  end

  battle.run

  # Finalize renderers
  renderers.each do |r|
    if r.is_a?(Rubowar::Renderers::Terminal)
      r.render_final(battle.winner)
    elsif r.is_a?(Hash) && r[:output]
      r[:output].close
    end
  end

  # Report generated files (always show, even in quiet mode)
  renderers.each do |r|
    if r.is_a?(Rubowar::Renderers::HtmlCanvas)
      warn "HTML replay: #{r.filepath}"
    elsif r.is_a?(Hash) && r[:file]
      warn "JSON log: #{r[:file]}"
    end
  end

  battle_result = {
    battle_number: i + 1,
    chronons: battle.chronon,
    winner: battle.winner&.name,
    rubots: battle.arena.actors.map do |r|
      {
        name: r.name,
        size: r.size,
        alive: r.alive?,
        health: r.health.round(1),
        damage_dealt: r.damage_dealt.round(1),
        damage_taken: r.damage_taken.round(1)
      }
    end
  }

  results << battle_result
end

# Skip summary output if quiet
exit 0 if options[:quiet]

# Generate summary statistics
wins = Hash.new(0)
total_damage = Hash.new(0.0)
total_health = Hash.new(0.0)
results.each do |r|
  wins[r[:winner]] += 1 if r[:winner]
  r[:rubots].each do |bot|
    total_damage[bot[:name]] += bot[:damage_dealt]
    total_health[bot[:name]] += bot[:health]
  end
end

summary = {
  battles: options[:battles],
  arena: {
    width: options[:width],
    height: options[:height],
    friction: options[:friction],
    chronon_limit: options[:chronon_limit]
  },
  seed: options[:seed],
  wins:,
  avg_damage: total_damage.transform_values { |v| (v / options[:battles]).round(1) },
  avg_health: total_health.transform_values { |v| (v / options[:battles]).round(1) }
}

# Output results
case options[:format]
when "json"
  output = {
    summary:,
    battles: results
  }
  puts JSON.pretty_generate(output)

when "csv"
  # Header
  puts "battle,ticks,winner,#{rubot_classes.map { |c| "#{c.name}_hp,#{c.name}_dmg" }.join(",")}"

  # Data rows
  results.each do |r|
    row = [r[:battle_number], r[:chronons], r[:winner] || "draw"]
    rubot_classes.each do |klass|
      bot = r[:rubots].find { |b| b[:name] == klass.name }
      row << (bot ? bot[:health] : 0)
      row << (bot ? bot[:damage_dealt] : 0)
    end
    puts row.join(",")
  end

when "text"
  puts "Battle: #{options[:battles]} battle(s)"
  puts "Arena: #{options[:width]}x#{options[:height]}, friction=#{options[:friction]}, chronon_limit=#{options[:chronon_limit]}"
  puts "Rubots: #{rubot_classes.map { |c| "#{c.name} (#{c.size})" }.join(", ")}"
  puts

  if options[:battles] == 1
    r = results.first
    puts "Result: #{r[:winner] || "Draw"} wins at chronon #{r[:chronons]}"
    puts
    puts "Final standings:"
    r[:rubots].sort_by { |b| [-b[:health], -b[:damage_dealt]] }.each_with_index do |bot, i|
      status = bot[:alive] ? "ALIVE" : "DEAD"
      puts "  #{i + 1}. #{bot[:name]}: HP=#{bot[:health].to_i} DMG=#{bot[:damage_dealt].to_i} [#{status}]"
    end
  else
    puts "Win rates:"
    rubot_classes.each do |klass|
      count = wins[klass.name]
      pct = (count.to_f / options[:battles] * 100).round(1)
      puts "  #{klass.name}: #{count}/#{options[:battles]} (#{pct}%)"
    end
    puts "  Draw: #{options[:battles] - wins.values.sum}/#{options[:battles]}" if wins.values.sum < options[:battles]

    puts
    puts "Averages per battle:"
    rubot_classes.each do |klass|
      name = klass.name
      puts "  #{name}: HP=#{summary[:avg_health][name]} DMG=#{summary[:avg_damage][name]}"
    end
  end
end
